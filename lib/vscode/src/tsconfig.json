{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"esModuleInterop": true,
		"removeComments": false,
		"preserveConstEnums": true,
		"sourceMap": false,
		"allowJs": true,
		"resolveJsonModule": true,
		"isolatedModules": false,
		"skipLibCheck": true,
		"outDir": "../out/vs",
		"types": [
			"@webgpu/types",
			"mocha",
			"semver",
			"sinon",
			"trusted-types",
			"winreg",
			"wicg-file-system-access"
		],
		"plugins": [
			{
				"name": "tsec",
				"exemptionConfig": "./tsec.exemptions.json"
			}
		]
	},
	"include": [
		"./*.ts",
		"./typings",
		"./vs/**/*.ts",
		"./vscode-dts/vscode.proposed.*.d.ts",
		"./vscode-dts/vscode.d.ts"
	],
	"exclude": [
		"vs/workbench/contrib/webview/browser/pre/service-worker.js",
		"vs/editor/editor.api.ts",
		"vs/editor/editor.main.ts",
		"vs/editor/standalone/**",
		"vs/platform/agentHost/browser/**",
		"vs/platform/agentHost/common/webPubSub/**",
		"vs/platform/browserView/node/**",
		"vs/workbench/contrib/authentication/**",
		"vs/workbench/contrib/issue/browser/issueQuickAccess.ts",
		"vs/workbench/contrib/issue/browser/issueReporterEditorInput.ts",
		"vs/workbench/contrib/issue/browser/issueReporterOverlay.ts",
		"vs/workbench/contrib/issue/browser/screenshotAnnotation.ts",
		"vs/workbench/contrib/imageCarousel/**",
		"vs/workbench/contrib/welcomeWalkthrough/**",
		"vs/workbench/services/agentHost/**",
		"vs/workbench/services/chat/**"
	]
}
