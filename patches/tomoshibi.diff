 /**
+ * Quote a path as one inert shell argument. Unlike {@link escapeNonWindowsPath},
+ * this preserves valid filename characters and is never an executable-path
+ * expression (for example, it never adds PowerShell's call operator).
+ */
+export function quoteShellArgument(path: string, shellType: TerminalShellType | undefined, os: OperatingSystem | undefined): string {
+	if (/[\x00-\x1F\x7F]/.test(path)) {
+		throw new Error('Shell arguments cannot contain control characters');
+	}
+	if (shellType === GeneralShellType.PowerShell) {
+		return `'${path.replaceAll('\'', '\'\'')}'`;
+	}
+	if (shellType === PosixShellType.Fish) {
+		return `'${path.replaceAll('\\', '\\\\').replaceAll('\'', '\\\'')}'`;
+	}
+	if (os === OperatingSystem.Windows && shellType === WindowsShellType.Wsl) {
+		throw new Error('Raw WSL argument conversion is unavailable');
+	}
+	if (os === OperatingSystem.Windows && shellType !== WindowsShellType.GitBash && shellType !== WindowsShellType.Wsl) {
+		if (/[%!]/.test(path)) {
+			throw new Error('Interactive Command Prompt arguments cannot safely contain % or !');
+		}
+		return `"${path.replaceAll('"', '""')}"`;
+	}
+	return `'${path.replaceAll('\'', `'\\''`)}'`;
+}
