+++ tomoshibi-code-server/lib/vscode/extensions/tomoshibi-leftbar/src/views/activityLaunchers.ts
@@ -0,0 +1,78 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import * as vscode from 'vscode';
+
+interface LauncherDefinition {
+	readonly viewId: string;
+	readonly command: string;
+	readonly label: string;
+}
+
+const launchers: readonly LauncherDefinition[] = [
+	{ viewId: 'tomoshibi.terminalLauncher', command: 'tomoshibi.openTerminal', label: '终端' },
+	{ viewId: 'tomoshibi.codexLauncher', command: 'tomoshibi.codexTerm', label: 'Codex' },
+	{ viewId: 'tomoshibi.claudeLauncher', command: 'tomoshibi.claudeTerm', label: 'Claude Code' },
+];
+
+class EmptyLauncherProvider implements vscode.TreeDataProvider<never> {
+	getTreeItem(): vscode.TreeItem {
+		throw new Error('Launcher views do not contain tree items.');
+	}
+
+	getChildren(): never[] {
+		return [];
+	}
+}
+
+export function registerActivityLaunchers(context: vscode.ExtensionContext): void {
+	for (const launcher of launchers) {
+		const view = vscode.window.createTreeView(launcher.viewId, {
+			treeDataProvider: new EmptyLauncherProvider(),
+			showCollapseAll: false,
+		});
+		let launching = false;
+		const launch = async (): Promise<void> => {
+			if (!view.visible || launching) {
+				return;
+			}
+
+			launching = true;
+			let launched = false;
+			try {
+				try {
+					await vscode.commands.executeCommand(launcher.command);
+					launched = true;
+				} catch (error) {
+					const message = error instanceof Error ? error.message : String(error);
+					void vscode.window.showErrorMessage(vscode.l10n.t('无法打开 {0}：{1}', launcher.label, message));
+				}
+				// Do not leave a launcher as the active view container. Otherwise a
+				// later Ctrl+B would reveal it and launch the command again.
+				try {
+					await vscode.commands.executeCommand('workbench.view.explorer');
+				} catch { }
+				try {
+					await vscode.commands.executeCommand('workbench.action.closeSidebar');
+				} catch { }
+				if (launched) {
+					try {
+						await vscode.commands.executeCommand('workbench.action.terminal.focus');
+					} catch { }
+				}
+			} finally {
+				launching = false;
+			}
+		};
+		context.subscriptions.push(view, view.onDidChangeVisibility(event => {
+			if (event.visible) {
+				void launch();
+			}
+		}));
+		if (view.visible) {
+			void launch();
+		}
+	}
+}
