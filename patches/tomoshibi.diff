+			opened: openedResources.map(resource => resource.toString()),
+		}, {
+			uploaded: selectedResources.map(resource => resource.toString()),
+			opened: [],
+		});
+	});
+
+	test('opens only an enabled, active upload whose first result is a file', async () => {
+		const firstResource = URI.parse('vscode-remote://test/home/user/first.txt');
+		const secondResource = URI.parse('vscode-remote://test/home/user/second.txt');
+		const outcomes: { label: string; opened: string[] }[] = [];
+
+		for (const scenario of [
+			{ label: 'default', options: undefined, isCancellationRequested: false, firstIsFile: true },
+			{ label: 'explicit true', options: { openUploadedFile: true }, isCancellationRequested: false, firstIsFile: true },
+			{ label: 'cancelled', options: undefined, isCancellationRequested: true, firstIsFile: true },
+			{ label: 'first result is a directory', options: undefined, isCancellationRequested: false, firstIsFile: false },
+		]) {
+			const openedResources: string[] = [];
+			await finalizeBrowserFileUpload(
+				[
+					{ isFile: scenario.firstIsFile, resource: firstResource },
+					{ isFile: true, resource: secondResource },
+				],
+				scenario.options,
+				scenario.isCancellationRequested,
+				async resource => { openedResources.push(resource.toString()); },
+			);
+			outcomes.push({ label: scenario.label, opened: openedResources });
+		}
+
+		assert.deepStrictEqual(outcomes, [
+			{ label: 'default', opened: [firstResource.toString()] },
+			{ label: 'explicit true', opened: [firstResource.toString()] },
+			{ label: 'cancelled', opened: [] },
+			{ label: 'first result is a directory', opened: [] },
+		]);
+	});
+
+	test('preserves input order when concurrent uploads finish out of order', async () => {
+		const inputResources = [
+			URI.parse('vscode-remote://test/home/user/first.txt'),
+			URI.parse('vscode-remote://test/home/user/second.txt'),
+			URI.parse('vscode-remote://test/home/user/third.txt'),
+		];
+		const pendingResults = inputResources.map(() => new DeferredPromise<{ isFile: boolean; resource: URI }>());
+		const completionOrder: string[] = [];
+		const resultsPromise = Promises.settled(pendingResults.map((pending, index) => pending.p.then(result => {
+			completionOrder.push(inputResources[index].path);
+			return result;
+		})));
+
+		await pendingResults[2].complete({ isFile: true, resource: inputResources[2] });
+		await pendingResults[1].complete({ isFile: true, resource: inputResources[1] });
+		await pendingResults[0].complete({ isFile: true, resource: inputResources[0] });
+		const uploadedResources = await finalizeBrowserFileUpload(
+			coalesce(await resultsPromise),
+			{ openUploadedFile: false },
+			false,
+			async () => { },
+		);
+
+		assert.deepStrictEqual({
+			completed: completionOrder,
+			uploaded: uploadedResources.map(resource => resource.path),
+		}, {
+			completed: [inputResources[2].path, inputResources[1].path, inputResources[0].path],
+			uploaded: inputResources.map(resource => resource.path),
+		});
+	});
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+});
