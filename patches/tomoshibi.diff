+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import * as vscode from 'vscode';
+
+function activeOrLastTerminal(): vscode.Terminal | undefined {
+	return vscode.window.activeTerminal ?? vscode.window.terminals.at(-1);
+}
+
+export function openDefaultTerminal(): void {
+	const existing = activeOrLastTerminal();
+	if (existing) {
+		existing.show();
+		return;
+	}
+
+	vscode.window.createTerminal({ name: vscode.l10n.t('命令行') }).show();
+}
+
+export function createTerminal(): void {
+	vscode.window.createTerminal({ name: vscode.l10n.t('命令行') }).show();
+}
+
+function openCliTerminal(configurationKey: 'codex' | 'claude', name: string): void {
+	const configuration = vscode.workspace.getConfiguration(`tomoshibi.${configurationKey}`);
+	const shellPath = configuration.get<string>('executable') ?? configurationKey;
+	const shellArgs = configuration.get<string[]>('args') ?? [];
+	const terminal = vscode.window.createTerminal({ name, shellPath, shellArgs });
+	terminal.show();
+}
+
+export function openCodexTerminal(): void {
+	openCliTerminal('codex', 'Codex');
+}
+
+export function openClaudeTerminal(): void {
+	openCliTerminal('claude', 'Claude Code');
+}
+
+export async function openClaudeGui(): Promise<void> {
+	const commands = await vscode.commands.getCommands(true);
+	if (!commands.includes('claude-vscode.editor.open')) {
+		const choice = await vscode.window.showWarningMessage(
+			vscode.l10n.t('Claude 图形界面不可用，要改为在终端打开 Claude Code 吗？'),
+			vscode.l10n.t('打开终端')
+		);
+		if (choice) {
+			openClaudeTerminal();
+		}
+		return;
+	}
+
+	await vscode.commands.executeCommand('claude-vscode.editor.open');
+}
+
+export function sendEscape(): void {
+	const terminal = activeOrLastTerminal();
+	if (!terminal) {
+		void vscode.window.showWarningMessage(vscode.l10n.t('现在没有打开的终端。'));
+		return;
+	}
+
+	terminal.sendText('\u001b', false);
+}
+
+export function sendEnter(): void {
+	activeOrLastTerminal()?.sendText('\r', false);
+}
+
+export function sendNewline(): void {
+	activeOrLastTerminal()?.sendText('\u001b\r', false);
+}
+
+export function scrollToBottom(): Thenable<void> {
+	return vscode.commands.executeCommand('workbench.action.terminal.scrollToBottom');
+}
