+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import * as vscode from 'vscode';
+import {
+	createTerminal,
+	openClaudeGui,
+	openClaudeTerminal,
+	openCodexTerminal,
+	openDefaultTerminal,
+	scrollToBottom,
+	sendEnter,
+	sendEscape,
+	sendNewline,
+} from './commands/terminals';
+import { registerActivityLaunchers } from './views/activityLaunchers';
+
+export function activate(context: vscode.ExtensionContext): void {
+	context.subscriptions.push(
+		vscode.commands.registerCommand('tomoshibi.openTerminal', openDefaultTerminal),
+		vscode.commands.registerCommand('tomoshibi.newTerminal', createTerminal),
+		vscode.commands.registerCommand('tomoshibi.codexTerm', openCodexTerminal),
+		vscode.commands.registerCommand('tomoshibi.claudeTerm', openClaudeTerminal),
+		vscode.commands.registerCommand('tomoshibi.claudeGui', openClaudeGui),
+		vscode.commands.registerCommand('tomoshibi.escape', sendEscape),
+		vscode.commands.registerCommand('tomoshibi.enter', sendEnter),
+		vscode.commands.registerCommand('tomoshibi.newline', sendNewline),
+		vscode.commands.registerCommand('tomoshibi.scrollBottom', scrollToBottom),
+	);
+	registerActivityLaunchers(context);
+
+	const escape = vscode.window.createStatusBarItem('tomoshibi.escape', vscode.StatusBarAlignment.Right, 930);
+	escape.name = vscode.l10n.t('终端 Esc');
+	escape.text = 'Esc';
+	escape.tooltip = vscode.l10n.t('向当前终端发送 Esc');
+	escape.command = 'tomoshibi.escape';
+	escape.show();
+	context.subscriptions.push(escape);
+
+	const latest = vscode.window.createStatusBarItem('tomoshibi.scrollBottom', vscode.StatusBarAlignment.Right, 895);
+	latest.name = vscode.l10n.t('回到终端最新输出');
+	latest.text = '$(chevron-down) ' + vscode.l10n.t('回到最新');
+	latest.tooltip = vscode.l10n.t('滚动到当前终端的最新输出');
+	latest.command = 'tomoshibi.scrollBottom';
+	latest.show();
+	context.subscriptions.push(latest);
+
+	const upload = vscode.window.createStatusBarItem('tomoshibi.upload', vscode.StatusBarAlignment.Right, 880);
+	upload.name = vscode.l10n.t('上传文件到当前命令行');
+	upload.text = '$(cloud-upload) ' + vscode.l10n.t('上传文件');
+	upload.tooltip = vscode.l10n.t('上传到当前命令行目录，并把路径插入原命令行');
+	upload.command = {
+		command: 'explorer.upload',
+		title: vscode.l10n.t('上传文件'),
+		arguments: [{ tomoshibiTarget: 'activeTerminal', insertIntoTerminal: true }],
+	};
+	upload.show();
+	context.subscriptions.push(upload);
+}
